# 内嵌前端的单二进制产物
/artex
# 运行日志绝不提交（含真实任务目标/LLM 流量；曾在 b39ee22 误入一次）
/artex.log
# 手动留存的旧二进制备份（artex.* 为改名前的全部历史产物）
/artex.*
/artex.prev*
/artex.old-*
# 一键更新在可执行文件旁留下的中间产物（暂存件 / 备份 / 失败版本 / 升级标记）
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/internal/platform/server/webui/dist/
/dist/

# JWT 签名密钥（运行时生成，存项目根，绝不提交）
/jwt.key
/4zrec
/4zrec.log
/4zrec.old*
/4zrec.new*
/4zrec.pre*

# Docker 部署生成的本地环境（含密码/密钥，不提交）
.env

# 调度器运行/模拟产生的事件日志（测试产物，不提交）
*-events.csv

# bench 基准测试相关（本地产物，不提交）
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# ZCode 本地会话产物（计划/上下文，仅本机）
.zcode/
