{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/c1ayooo/capkit/contracts/tool.json",
  "title": "ToolSpec",
  "description": "Cross-boundary tool contract. Kits publish these; hosts expose them to agents and UIs.",
  "type": "object",
  "required": ["name", "description", "input_schema", "risk"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "risk": { "enum": ["low", "medium", "high"] },
    "rate_limit": {
      "type": "object",
      "properties": {
        "per_second": { "type": "number", "minimum": 0 },
        "burst": { "type": "integer", "minimum": 0 },
        "concurrency": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
