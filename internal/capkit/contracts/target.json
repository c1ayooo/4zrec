{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/c1ayooo/capkit/contracts/target.json",
  "title": "Target",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "project_id": { "type": "integer" },
    "kind": { "enum": ["url", "host", "domain", "ip", "cidr"] },
